<%- include('./includes/header'); -%>

<div class="nav-bar">
  <button
    class="menu-action box"
    id="menu-toggle"
    type="button"
    aria-controls="list-menu"
    aria-expanded="false"
    aria-label="Open list menu"
  >
    <img src="/icons/menu.svg" alt="menu button" class="menu-icon" id="menu-icon" />
  </button>

  <div class="box" id="heading">
    <h1><%= title %></h1>
  </div>
</div>

<div class="content-layout">
  <aside class="list-menu" id="list-menu" aria-hidden="true">
    <div class="list-menu-header">
      <h2 class="list-menu-title">Your lists</h2>
      <button
        class="list-menu-close"
        id="list-menu-close"
        type="button"
        aria-label="Close list menu"
      >
        <img src="/icons/x.svg" alt="" class="menu-icon" />
      </button>
    </div>

    <nav class="list-links" aria-label="Available lists">
      <% availableLists.forEach((list) => { %>
        <a
          class="list-link <%= list.key === listKey ? 'is-active' : '' %>"
          href="<%= list.href %>"
          <%= list.key === listKey ? 'aria-current="page"' : '' %>
        >
          <span><%= list.name %></span>
        </a>
      <% }); %>
    </nav>

    <div class="list-menu-footer">
      <button class="new-list-button" id="new-list-button" type="button">
        <span aria-hidden="true">+</span>
        <span>New list</span>
      </button>
    </div>
  </aside>

  <div class="menu-backdrop" id="menu-backdrop" data-menu-close></div>

  <main>
    <div class="box todo-box">
      <% newListItems.forEach((item)=>{ %>
      <form action="/del" method="post">
        <div class="item">
          <input
            class="item-checkbox"
            type="checkbox"
            name="box"
            value="<%= item %>"
          />
          <p><%= item %></p>
        </div>
        <input type="hidden" name="listName" value="<%= listKey %>" />
      </form>
      <% }); %>

      <% if (newListItems.length === 0) { %>
      <div class="empty-state" role="status">
        <img src="/icons/square-dashed-plus.svg" alt="" />
        <p>Add an item to see it here</p>
      </div>
      <% } %>

      <form class="item" action="/" method="post">
        <input
          type="text"
          name="newItem"
          placeholder="New Item"
          autocomplete="off"
        />

        <input type="hidden" name="listName" value="<%= listKey %>" />
        <button type="submit" aria-label="Add item">+</button>
      </form>
    </div>

    <div id="footer">
        © Copyright <span id="year">2022</span>.
    </div>
  </main>
</div>

<%- include('./includes/dialog'); -%>
<%- include('./includes/footer'); -%>
