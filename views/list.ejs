<%- include('./includes/header'); -%>

<div class="nav-bar">
  <div class="menu-action box">
    <img src="/icons/menu.svg" alt="Menu" class="menu-icon" />
  </div>
  
  <div class="box" id="heading">
    <h1><%= title %></h1>
  </div>
</div>

<div class="box" style="margin: 50px auto;">
  <% newListItems.forEach((item)=>{ %>
  <form action="/del" method="post">
    <div class="item">
      <input
        type="checkbox"
        name="box"
        value="<%= item %>"
        onchange="this.form.submit()"
      />
      <p><%= item %></p>
    </div>
    <input type="hidden" name="listName" value="<%= title %>" />
  </form>
  <% }); %>

  <form class="item" action="/" method="post">
    <input
      type="text"
      name="newItem"
      placeholder="New Item"
      autocomplete="off"
    />

    <button type="submit" name="button" value="<%= title %>">+</button>
  </form>
</div>

<%- include('./includes/footer'); -%>
